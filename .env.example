OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_PREDICTION_MODEL=gpt-5.4-mini
OPENAI_NEWS_MODEL=gpt-5.4-mini
OPENAI_SOCIAL_MODEL=gpt-5.4-mini
OPENAI_PREMIUM_MODEL=gpt-5.4
OPENAI_USE_PREMIUM_PREDICTIONS=false

THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

LIVE_POSTING=false
POST_STORAGE_PATH=./data/threads-posts.json
MATCH_DATA_PATH=./match-data.json

MAX_POSTS_PER_DAY=6
MAX_LINK_POSTS_PER_DAY=1
MIN_POST_INTERVAL_MINUTES=90
TENNISTIPZ_URL=https://tennistipz.win

CONTENT_AUTOPUBLISH_ENABLED=true
CONTENT_AUTOPUBLISH_CRON=0 6 * * *
DAILY_MATCH_PREDICTIONS_COUNT=1
DAILY_PLAYER_ANALYSIS_COUNT=1
DAILY_TOURNAMENT_PREVIEWS_COUNT=1
DAILY_NEWS_REACTIONS_COUNT=1
DAILY_EVERGREEN_ARTICLES_COUNT=1

DB_MAINTENANCE_CRON=0 */2 * * *
DB_MAINTENANCE_PROFILE_LIMIT=3
DB_MAINTENANCE_PLAYER_WINDOW=500
DB_MAINTENANCE_OUTCOME_DAYS=180
DB_MAINTENANCE_OUTCOME_LIMIT=60
